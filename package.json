{
  "name": "adnify-cli",
  "version": "0.1.2",
  "description": "Adnify-Cli — Your terminal. Your model. Your code.",
  "author": "adnaan",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ai",
    "cli",
    "terminal",
    "coding-assistant",
    "agent",
    "ink",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ad-naan/Adnify-Cli.git"
  },
  "homepage": "https://github.com/ad-naan/Adnify-Cli#readme",
  "bugs": {
    "url": "https://github.com/ad-naan/Adnify-Cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "packageManager": "bun@1.3.6",
  "bin": {
    "adnify": "dist/adnify-cli.js"
  },
  "files": [
    "dist/adnify-cli.js",
    "prompts/",
    ".rules/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/main.tsx",
    "start": "bun run src/main.tsx",
    "build": "bun build ./src/main.tsx --outfile ./dist/adnify-cli.js --target node",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "eval:agent": "bun test src/infrastructure/llm/ModelAssistantResponder.test.ts src/infrastructure/llm/ModelContextCompactor.test.ts src/infrastructure/agent/LocalSubAgentOrchestrator.test.ts src/infrastructure/agent/GitWorktreeManager.test.ts src/infrastructure/tooling/LocalToolExecutor.test.ts src/infrastructure/tooling/PendingUserInteractionAdapter.test.ts src/infrastructure/tooling/handlers/taskHandler.test.ts src/infrastructure/tooling/handlers/askUserHandler.test.ts src/infrastructure/tooling/handlers/planDocumentHandler.test.ts src/infrastructure/checkpoint/CheckpointManager.test.ts src/infrastructure/prompt/loadProjectInstructions.test.ts src/presentation/ink/components/ConversationViewport.test.tsx src/presentation/ink/components/ChoiceTabs.test.tsx",
    "verify": "bun test && bun run typecheck && bun run build && node --check ./dist/adnify-cli.js",
    "check": "bun test src/domain/session/aggregates/ConversationSession.test.ts",
    "prepublishOnly": "bun run verify",
    "postbuild": "node -e \"const fs=require('fs');const f='dist/adnify-cli.js';const s=fs.readFileSync(f,'utf8');const body=s.startsWith('#!')?s.replace(/^#![^\\n]*\\n/,''):s;fs.writeFileSync(f,'#!/usr/bin/env node\\n'+body);console.log('Node.js shebang added.')\""
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.109",
    "@ai-sdk/google": "^3.0.106",
    "@ai-sdk/openai": "^3.0.93",
    "@ai-sdk/openai-compatible": "^2.0.66",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "ai": "^6.0.248",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "undici": "^6.28.0",
    "ws": "^8.20.1"
  }
}
